{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/admin/users",
        "function": {
          "functionId": "provisionUser",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/ai/draft-billing-items",
        "function": {
          "functionId": "draftBillingItems",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/ai/assistant",
        "function": {
          "functionId": "aiAssistant",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/ai/meeting-summary",
        "function": {
          "functionId": "aiMeetingSummary",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
