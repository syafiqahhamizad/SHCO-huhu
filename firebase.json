{
  "hosting": {
    "site": "gen-lang-client-0565207218",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/ai/draft-billing-items",
        "function": {
          "functionId": "draftBillingItems",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/ai/assistant",
        "function": {
          "functionId": "aiAssistant",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/ai/meeting-summary",
        "function": {
          "functionId": "meetingSummary",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
