rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isFirmUser() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.matches('.*@shcolaw\\.com$');
    }

    match /practiceSystem/sharedState {
      allow read, write: if isFirmUser();
    }
  }
}
