rules_version = '2';

// Access model (no Cloud Functions / custom claims needed):
//
//  1. The owner — the Managing Partner, hardcoded below — with a verified email.
//  2. Anyone on the owner-managed access list `practiceSystem/access`:
//       { users: { <emailKey>: { email, role, admin, active } }, updatedAt, updatedBy }
//     emailKey = lowercase email with '.' replaced by ','. The entry must be active and the
//     sign-in's email verified (Google Workspace sign-ins always are; password accounts must
//     click the verification email).
//  3. TRANSITIONAL: the old custom-claims checks, only for people who have NO entry on the
//     list (so switching someone off on the list always wins over an old claim).
//
// Only the owner can write the access list. Everything else is denied.

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return isSignedIn() && request.auth.token.get('email', null) is string;
    }

    function emailVerified() {
      return hasEmail() && request.auth.token.get('email_verified', false) == true;
    }

    function isOwner() {
      return emailVerified() && request.auth.token.email.lower() == 'syafiqahhamizad@shcolaw.com';
    }

    // Same key the app computes (accessListService.emailToAccessKey). replace() takes a
    // regular expression and replaces every match: '\\.' is the regex \. (a literal dot).
    function accessKey() {
      return request.auth.token.email.lower().replace('\\.', ',');
    }

    function accessPath() {
      return /databases/$(database)/documents/practiceSystem/access;
    }

    function accessUsers() {
      return exists(accessPath()) ? get(accessPath()).data.get('users', {}) : {};
    }

    function isListed() {
      return hasEmail() && accessKey() in accessUsers();
    }

    function listedActiveWithRole(roles) {
      let users = accessUsers();
      let key = accessKey();
      return emailVerified() &&
        key in users &&
        users[key].get('active', false) == true &&
        users[key].get('role', '') in roles;
    }

    // ---- Transitional legacy custom-claims checks (unchanged logic), only for people who
    // ---- are not on the access list at all.
    function legacyFirmUser() {
      return hasEmail() && !isListed() && (
        (
          request.auth.token.get('email_verified', false) == true &&
          request.auth.token.email.matches('.*@shcolaw\\.com$') &&
          (request.auth.token.get('role', '') == 'partner' || request.auth.token.get('role', '') == 'lawyer')
        ) ||
        request.auth.token.get('role', '') == 'assistant' ||
        request.auth.token.get('role', '') == 'accountant' ||
        request.auth.token.get('role', '') == 'reviewer'
      );
    }

    function isFirmUser() {
      return isOwner() ||
        listedActiveWithRole(['partner', 'lawyer', 'assistant', 'accountant', 'reviewer']) ||
        legacyFirmUser();
    }

    // ---- Database split (firm/main/...). Layout and tiers: src/services/firmData.ts.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isListedAdmin() {
      let users = accessUsers();
      let key = accessKey();
      return emailVerified() && key in users &&
        users[key].get('active', false) == true && users[key].get('admin', false) == true;
    }

    function isAdminOrOwner() {
      return isOwner() || isListedAdmin();
    }

    function metaPath() {
      return /databases/$(database)/documents/firm/main;
    }

    function splitStarted() {
      return exists(metaPath());
    }

    function splitDone() {
      return splitStarted() && get(metaPath()).data.get('state', '') == 'done';
    }

    // firm  — every firm user;  books — partners, accountants, reviewers (read), admins, owner;
    // hr    — partners, accountants, admins, owner, or the person's own document;
    // own   — only the person it belongs to (private to-dos), nobody else;
    // users — everyone reads; admins write; people may update their own non-sensitive fields.
    function tierOf(col) {
      return col in ['manualJournals', 'financeConfig', 'bankAccounts', 'bankReconciliationEntries', 'trustAuditLogs', 'generalLedger', 'clientAccountChecks'] ? 'books'
        : col in ['payslips', 'staffPrivate'] ? 'hr'
        : col == 'privateTodos' ? 'own'
        : col == 'users' ? 'users'
        : col == 'config' ? 'config'
        : col in ['leads', 'clients', 'cases', 'quotations', 'referralPartners', 'paymentVouchers', 'travelClaims', 'receipts',
                  'deadlines', 'invoices', 'payments', 'retainers', 'attendanceRecords', 'leaveApplications', 'meetings', 'programmes',
                  'notifications', 'lawFirmRegistry', 'deletedRecords', 'timeEntries', 'expenses', 'announcements', 'auditLogs',
                  'firmStartCentrePages', 'inventoryItems', 'logs'] ? 'firm'
        : 'none';
    }

    function booksReader() {
      return isAdminOrOwner() || listedActiveWithRole(['partner', 'accountant', 'reviewer']);
    }

    function booksWriter() {
      return isAdminOrOwner() || listedActiveWithRole(['partner', 'accountant']);
    }

    function hrStaff() {
      return isAdminOrOwner() || listedActiveWithRole(['partner', 'accountant']);
    }

    function ownDoc(data) {
      return data.get('_ownerEmail', '') == myEmail();
    }

    match /firm/main {
      // Split status. Only the owner starts / finishes the one-time move.
      allow read: if isFirmUser();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /firm/main/{col}/{docId} {
      allow read: if (splitDone() || isOwner()) && (
        (tierOf(col) in ['firm', 'users', 'config'] && isFirmUser()) ||
        (tierOf(col) == 'books' && booksReader()) ||
        (tierOf(col) == 'hr' && (hrStaff() || (isFirmUser() && ownDoc(resource.data)))) ||
        (tierOf(col) == 'own' && isFirmUser() && ownDoc(resource.data))
      );

      // While the move is running only the owner writes; afterwards each tier's writers.
      allow create, update, delete: if (!splitDone() && isOwner()) || (splitDone() && (
        (tierOf(col) == 'firm' && isFirmUser()) ||
        (tierOf(col) == 'books' && booksWriter()) ||
        (tierOf(col) == 'hr' && hrStaff()) ||
        (tierOf(col) == 'config' && (docId in ['rolesMatrix', 'customRoles'] ? isOwner() : isFirmUser())) ||
        (tierOf(col) == 'users' && isAdminOrOwner())
      ));

      // Private to-dos: only the person they belong to — no partner, Accounts or admin access.
      allow create, update: if splitDone() && tierOf(col) == 'own' && isFirmUser() &&
        ownDoc(request.resource.data) && (resource == null || ownDoc(resource.data));
      allow delete: if splitDone() && tierOf(col) == 'own' && isFirmUser() && ownDoc(resource.data);

      // Your own private staff profile (personal details, emergency contact …).
      allow create, update: if splitDone() && col == 'staffPrivate' && isFirmUser() &&
        ownDoc(request.resource.data) && (resource == null || ownDoc(resource.data));

      // Your own user record (or anyone's, for partners / accounts keeping employee records):
      // everything except role, admin, status, e-mail and permissions.
      allow update: if splitDone() && col == 'users' && isFirmUser() &&
        (resource.data.get('email', '').lower() == myEmail() || hrStaff()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'email', 'role', 'isAdmin', 'isSuperAdmin', 'status', 'navOverrides', 'code']);

      // Adding yourself to the roster at first sign-in, with the role the owner gave you.
      allow create: if splitDone() && col == 'users' && isFirmUser() &&
        request.resource.data.get('email', '').lower() == myEmail() &&
        request.resource.data.get('isAdmin', false) != true &&
        request.resource.data.get('isSuperAdmin', false) != true &&
        accessKey() in accessUsers() &&
        request.resource.data.get('role', '').lower() == accessUsers()[accessKey()].get('role', '');
    }

    match /practiceSystem/sharedState {
      // Per-module/per-action restrictions (Reviewer read-only, etc.) are enforced
      // client-side via canViewModule/hasModulePermission. Clients must NOT read this doc:
      // it holds every client, file, finance and staff record.
      // After the database split this document is a frozen backup only the owner can read.
      allow read: if isOwner() || (isFirmUser() && !splitStarted());
      allow write: if isFirmUser() && !splitStarted();
    }

    match /practiceSystem/access {
      // The owner reads it to keep it in sync; a listed, active, verified person may read it
      // to learn their own role at sign-in. Nobody else — not even other signed-in accounts.
      allow get: if isOwner() || (
        emailVerified() &&
        accessKey() in resource.data.get('users', {}) &&
        resource.data.users[accessKey()].get('active', false) == true
      );
      // Only the owner may create/replace it. Deleting it is not allowed from the app.
      allow create, update: if isOwner() &&
        request.resource.data.keys().hasOnly(['users', 'updatedAt', 'updatedBy']) &&
        request.resource.data.users is map;
    }

    // E-mail queue for the portal's mail sender (functions-mail; sends through Google Workspace).
    // Staff may only queue a message to one firm address; only the owner can look at a queued
    // message, and nobody can change or delete the queue from the app (the sender works with server access).
    match /mail/{mailId} {
      allow create: if isFirmUser() &&
        request.resource.data.keys().hasOnly(['to', 'message', 'createdBy', 'createdAt']) &&
        request.resource.data.to is string &&
        request.resource.data.to.matches('^[a-z0-9._%+-]+@shcolaw[.]com$') &&
        request.resource.data.message is map &&
        request.resource.data.message.keys().hasOnly(['subject', 'text', 'html']) &&
        request.resource.data.message.subject is string && request.resource.data.message.subject.size() <= 200 &&
        request.resource.data.message.text is string && request.resource.data.message.text.size() <= 5000 &&
        request.resource.data.message.html is string && request.resource.data.message.html.size() <= 8000 &&
        request.resource.data.createdAt == request.time;
      // The owner may follow a test e-mail's delivery status (Settings → Notification e-mails).
      allow get: if isOwner();
      allow list, update, delete: if false;
    }

    // E-mail settings for the mail sender (functions-mail). Only the owner sets them; the App
    // password can be written but never read back by anyone in the app (the function reads it
    // with server access).
    match /privateConfig/mail {
      allow get: if isOwner();
      allow create, update: if isOwner() &&
        request.resource.data.keys().hasOnly(['smtpUser', 'from', 'replyTo', 'passwordSetAt', 'updatedBy', 'updatedAt']) &&
        request.resource.data.get('smtpUser', '').matches('^[a-z0-9._%+-]+@shcolaw[.]com$');
      allow list, delete: if false;
    }

    match /privateConfig/mailSecret {
      allow create, update: if isOwner() &&
        request.resource.data.keys().hasOnly(['smtpPass', 'updatedAt']) &&
        request.resource.data.smtpPass is string && request.resource.data.smtpPass.size() <= 64;
      allow read, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
