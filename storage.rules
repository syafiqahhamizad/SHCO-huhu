rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isApprovedIdentity() {
      return isAuthenticated() && request.auth.token.email != null &&
        (
          request.auth.token.email == 'syafiqahhamizad@shcolaw.com'
        );
    }

    function isFirmStaff() {
      return isAuthenticated() && request.auth.token.email != null &&
        request.auth.token.email.matches('.*@shcolaw\\.com$') &&
        (
          request.auth.token.role == 'partner' ||
          request.auth.token.role == 'lawyer' ||
          request.auth.token.role == 'assistant' ||
          request.auth.token.role == 'reviewer'
        );
    }

    function isCompanyAdmin() {
      return isFirmStaff() && request.auth.token.approvedIdentity == true && (
        request.auth.token.admin == true ||
        request.auth.token.superAdmin == true
      );
    }

    function isClient() {
      return isAuthenticated() && request.auth.token.role == 'client' && request.auth.token.email != null;
    }

    match /confidential/{allPaths=**} {
      allow read, write: if isFirmStaff();
    }

    match /clients/{clientId}/{allPaths=**} {
      allow read: if isFirmStaff() || (isClient() && request.auth.token.email == resource.metadata.ownerEmail);
      allow write: if isCompanyAdmin() || (isClient() && request.auth.uid == clientId && request.auth.token.email == request.resource.metadata.ownerEmail);
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
